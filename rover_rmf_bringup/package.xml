<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_rmf_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch and fleet configuration for Open-RMF managing Rover A1 over VDA 5050 / MQTT:
    traffic schedule, blockade, dispatcher, building map server and the rover fleet adapter.
  </description>
  <maintainer email="potlogradu@gmail.com">radupotlog</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rmf_building_map_tools</exec_depend>
  <exec_depend>rmf_task_ros2</exec_depend>
  <exec_depend>rmf_traffic_ros2</exec_depend>
  <exec_depend>rmf_visualization</exec_depend>
  <exec_depend>rover_rmf_fleet_adapter</exec_depend>
  <exec_depend>rover_rmf_maps</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
